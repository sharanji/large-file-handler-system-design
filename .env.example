SQLITE_DB_PATH=./data/app.db

# Elastic Cloud HTTPS endpoint (or local)
ELASTICSEARCH_URL=https://YOUR_DEPLOYMENT.es.REGION.gcp.elastic-cloud.com:443
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=

# Optional Cloud ID (used with API key instead of URL)
# ELASTIC_CLOUD_ID=

GOOGLE_APPLICATION_CREDENTIALS=your-service-account.json

# Cloud Run (used by deploy.sh)
REGION=us-central1
SERVICE_NAME=largefile-searching-system
MEMORY=1Gi
CPU=1
TIMEOUT=3600
MIN_INSTANCES=1
MAX_INSTANCES=3
